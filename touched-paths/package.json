{
  "name": "touched-paths",
  "version": "1.0.0",
  "description": "GitHub Action to detect if a pull request modified files matching specified glob groups",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "test": "vitest run",
    "build": "esbuild src/index.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs"
  },
  "keywords": [
    "actions",
    "github-actions",
    "paths",
    "diff",
    "pull-request"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vitest": "^3.0.7"
  }
}
